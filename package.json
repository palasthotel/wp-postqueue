{
  "name": "@palasthotel/postqueue",
  "version": "2.1.2",
  "description": "Be free to order posts as you wish. Plugin is available at [WordPress.org](https://wordpress.org/plugins/postqueue/)",
  "private": true,
  "scripts": {
    "watch": "wp-scripts start src/editor.js src/meta-box.js src/block-editor.js --output-path=public/dist",
    "build": "wp-scripts build src/editor.js src/meta-box.js src/block-editor.js --output-path=public/dist",
    "pack": "npm run build && SLUG=postqueue bash ../github-workflows/wp-plugin/bin/pack.sh",
    "lint:js": "wp-scripts lint-js src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palasthotel/wp-postqueue.git"
  },
  "author": {
    "name": "Palasthotel",
    "email": "webmaster@palasthotel.de",
    "url": "https://palasthotel.de"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/palasthotel/wp-postqueue/issues"
  },
  "homepage": "https://github.com/palasthotel/wp-postqueue#readme",
  "devDependencies": {
    "@cyclonedx/webpack-plugin": "5.3.3",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/block-editor": "^18.1.0",
    "@wordpress/blocks": "^16.2.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/compose": "^8.10.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/dom-ready": "^4.57.0",
    "@wordpress/editor": "^15.2.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/hooks": "^4.57.0",
    "@wordpress/icons": "^19.0.0",
    "@wordpress/plugins": "^7.57.0",
    "@wordpress/scripts": "^36.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1"
  }
}
